# Copia este archivo como .env.local para desarrollo y agrega las mismas
# variables en Vercel (Project → Settings → Environment Variables).
# Nunca subas .env.local al repositorio.

# URL pública del sitio (dominio definitivo). En Vercel se detecta sola si se deja vacía.
NEXT_PUBLIC_SITE_URL=

# --- Destino de los leads del formulario ---------------------------------
# Opción 1: webhook (Zapier, Make, n8n o el webhook del CRM que elijan).
LEADS_WEBHOOK_URL=

# Opción 2 (también sirve de respaldo si el webhook falla): correo con Resend.
# Crea una cuenta en resend.com, verifica el dominio y genera una API key.
RESEND_API_KEY=
LEADS_TO_EMAIL=
# Remitente con el dominio verificado, p. ej. "PaoClean Web <web@paoclean.com>".
LEADS_FROM_EMAIL=
